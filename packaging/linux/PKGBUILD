# Arch Linux package using the system electron.
#   cd packaging/linux && makepkg -si
pkgname=not-enough-tokens
pkgver=0.1.0
pkgrel=1
pkgdesc='Claude Code usage across machines, with a web console'
arch=('any')
url='https://github.com/ray1422/not-enough-tokens'
license=('custom')
depends=('electron' 'openssh' 'curl')
optdepends=('git: group usage by repository' 'python: faster reads of remote machines')
source=("$pkgname::git+ssh://git@github.com/ray1422/not-enough-tokens.git")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname"
  DESTDIR="$pkgdir" PREFIX=/usr sh packaging/linux/install.sh
}
