#!/bin/sh
# Launches the app with the system Electron (no Electron is bundled on Linux).
APP_DIR="${NET_APP_DIR:-@APP_DIR@}"
ELECTRON="${ELECTRON:-$(command -v electron 2>/dev/null)}"
if [ -z "$ELECTRON" ]; then
  echo "not-enough-tokens: 'electron' not found. Install your distribution's electron package or set ELECTRON=/path/to/electron." >&2
  exit 1
fi
exec "$ELECTRON" "$APP_DIR" "$@"
