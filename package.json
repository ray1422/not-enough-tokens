{
  "name": "not-enough-tokens",
  "version": "0.1.0",
  "description": "Incremental Claude Code usage tracker across machines, with a web console",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "net": "src/cli.js"
  },
  "scripts": {
    "serve": "node src/cli.js serve",
    "sync": "node src/cli.js sync",
    "test": "node --test test/",
    "electron": "electron .",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.ray1422.not-enough-tokens",
    "productName": "Not Enough Tokens",
    "files": [
      "electron/**",
      "src/**",
      "web/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/askpass.sh"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
