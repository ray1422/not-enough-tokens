{
  "name": "not-enough-tokens",
  "version": "0.1.1",
  "description": "Incremental Claude Code usage tracker across machines, with a web console",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "net": "src/cli.js"
  },
  "scripts": {
    "serve": "node src/cli.js serve",
    "sync": "node src/cli.js sync",
    "app": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "install:linux": "sh packaging/linux/install.sh",
    "dist:linux": "electron-builder --linux AppImage --x64 --arm64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.ray1422.not-enough-tokens",
    "productName": "Not Enough Tokens",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "web/**",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "not-enough-tokens-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "not-enough-tokens",
      "artifactName": "not-enough-tokens-${version}-${arch}.${ext}",
      "synopsis": "Claude Code usage across machines",
      "desktop": {
        "entry": {
          "StartupWMClass": "not-enough-tokens"
        }
      }
    }
  }
}
